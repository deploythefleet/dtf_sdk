menu "Deploy The Fleet SDK"

    menu "Logging"

        config DTF_LOGGING_UART_ENABLED
        bool "Enable UART Logger"
        default n
        help
            Enables logging over the default UART0 port

        config DTF_LOGGING_USE_COLOR
        bool "Enable Terminal Colors"
        default n 
        help
           Enables the use of terminal colors for log messages 

    endmenu

    menu "OTA"

        config DTF_OTA_TIMEOUT_MS
        int "HTTP Client Timeout (ms)"    
        default 25000
        help
            The HTTP client timeout in seconds during the OTA update process
        
        config DTF_OTA_HTTP_RX_BUFFER_SIZE
        int "HTTP RX Buffer Size"
        default 2048
        help
            The size of the buffer used to receive HTTP data during the OTA update process

        config DTF_OTA_HTTP_TX_BUFFER_SIZE
        int "HTTP TX Buffer Size"
        default 1024
        help
            The size of the buffer used to transmit HTTP data during the OTA update process

    endmenu

    menu "Profiling Settings"

        config DTF_RUNTIME_PROFILING_SAMPLE_INTERVAL
        int "Sample Interval (ms)"
        default 500
        help
            The interval in milliseconds between system resource samples

    endmenu

    menu "Observability"

        config DTF_OBSERVABILITY
        bool "Enable Observability"
        default n
        help
            Master compile-time toggle for the DTF observability subsystem
            (dtf_log / dtf_metric). When disabled the entire observability
            code is excluded from the binary — zero size impact.

        config DTF_OBS_BUFFER_SIZE
        int "Event Buffer Size (max events)"
        default 32
        depends on DTF_OBSERVABILITY
        help
            Maximum number of log/metric events held in the in-memory ring
            buffer before the oldest event is dropped. Tune based on
            available heap (each event is ~176 bytes).

        config DTF_OBS_FLUSH_INTERVAL_MS
        int "Flush Interval (ms)"
        default 30000
        depends on DTF_OBSERVABILITY
        help
            How often (in milliseconds) the background flush task sends
            buffered events to the ingest gateway.

        config DTF_OBS_GATEWAY_URL
        string "Ingest Gateway URL"
        default "https://ingest.deploythefleet.io/v1/ingest"
        depends on DTF_OBSERVABILITY
        help
            Full URL of the DTF ingest endpoint. Override for staging or
            self-hosted deployments.

    endmenu

endmenu